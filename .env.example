# ---- Oracle connection -------------------------------------------------
ORACLE_USER=your_db_user
ORACLE_PASSWORD=your_db_password

# Option A: full DSN  (host:port/service)
ORACLE_DSN=192.168.1.50:1521/ORCLPDB1

# Option B: individual parts (used only if ORACLE_DSN is blank)
#ORACLE_HOST=192.168.1.50
#ORACLE_PORT=1521
#ORACLE_SERVICE=ORCLPDB1

# Thick mode uses the installed Oracle client (default ON). Set to 0 for thin.
ORACLE_THICK_MODE=1
# Optional: explicit path to instant client libs if not on PATH/LD_LIBRARY_PATH
#ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_21_12

# ---- Object names (override if your tables/views differ) ---------------
REG_TABLE=PAT_PATIENT_DEMOGRAPHICS
REG_DATE_COLUMN=REGISTERED_SINCE
ENC_TABLE=PAT_FIN_ENCOUNTER
ENC_DATE_COLUMN=START_DATE
ENC_VALID_ONLY=1
EMPLOYEE_NAME_FN=GET_EMPLOYEE_NAME

# ---- Chart history windows ---------------------------------------------
DAYS_HISTORY=30
WEEKS_HISTORY=12
MONTHS_HISTORY=12

# ---- App ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
SECRET_KEY=change-me
