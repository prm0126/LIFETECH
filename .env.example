# Copy this file to .env and fill in your Oracle connection details.

# Oracle username and password
ORACLE_USER=scott
ORACLE_PASSWORD=tiger

# DSN: either host:port/service_name  or  a tnsnames.ora alias
ORACLE_DSN=localhost:1521/XEPDB1

# Optional: schema to browse. Defaults to the connected user's own schema.
ORACLE_SCHEMA=

# Driver mode. Thin mode (default) needs no Oracle client install.
# Set to true only if you need thick mode (advanced features / older DBs).
ORACLE_THICK=false
# Required only when ORACLE_THICK=true and the client libs aren't on PATH.
# ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_21_12

# Web server port
PORT=5000
